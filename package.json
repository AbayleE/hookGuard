{
  "name": "@efrata/hookguard",
  "version": "0.1.0",
  "description": "Zero-dependency webhook signature verification for Stripe, GitHub, Shopify, Slack, Twilio, Zoho (Billing & Sign), HubSpot, Clerk, and Discord.",
  "license": "MIT",
  "author": "Efrata Bayle",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AbayleE/hookGuard.git"
  },
  "homepage": "https://github.com/AbayleE/hookGuard#readme",
  "bugs": {
    "url": "https://github.com/AbayleE/hookGuard/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "example": "tsx examples/express-demo.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "keywords": [
    "webhook",
    "signature",
    "hmac",
    "stripe",
    "github",
    "shopify",
    "slack",
    "twilio",
    "hubspot",
    "security",
    "zoho",
    "clerk",
    "discord"
  ],
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.19.0",
    "express": "^4.22.0",
    "tsup": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.12"
  }
}
